{
  "name": "jungle-gaming-backend-challenge",
  "version": "1.0.0",
  "private": true,
  "description": "Distributed wagering processor required by the Jungle Gaming backend challenge README.",
  "scripts": {
    "build": "nest build",
    "start": "bun dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "bun dist/main.js",
    "migrate": "bun scripts/migrate.ts",
